# Hymn Router — isi key yang lu punya, kosongkan sisanya.
# Tanpa key sama sekali pun router jalan lewat Kilo + LLM7 (keyless).
# JANGAN commit file .env asli. Jangan pakai prefix NEXT_PUBLIC_* di sini.

# Groq — https://console.groq.com/keys (gratis, tanpa kartu)
# Model: openai/gpt-oss-120b | 30 RPM, 1000 req/hari, 200K token/hari
GROQ_API_KEY=

# NVIDIA NIM — https://build.nvidia.com (gratis, butuh verifikasi HP)
# Model: nvidia/nemotron-3-ultra-550b-a55b | ~40 RPM, 10K req/hari
NVIDIA_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey (gratis, tanpa kartu)
# Default model: gemini-3.5-flash-lite (500 req/hari).
# Bisa ganti ke gemini-3.8-flash (lebih pinter, cuma 20 req/hari).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter — https://openrouter.ai/keys (gratis, tanpa kartu)
# Default model: nvidia/nemotron-3-ultra-550b-a55b:free | 20 RPM, 50 req/hari
# Alternatif: openrouter/free (auto-pilih model :free yang lagi kosong)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Mistral — https://console.mistral.ai/api-keys (free mode, $10 kredit/bulan)
MISTRAL_API_KEY=

# Kilo Code — opsional, tanpa key sudah jalan (200 req/jam per IP)
# Key gratis di https://kilo.ai kalau mau limit lebih longgar.
KILO_API_KEY=

# LLM7 — opsional, tanpa key sudah jalan (model turbo)
# Token gratis di https://token.llm7.io (60 RPM, 250 req/jam, 100K token/24 jam)
LLM7_API_KEY=

# Dipakai sebagai HTTP-Referer untuk OpenRouter (opsional).
# Isi dengan domain deploy lu, mis. https://router.hymndavinci.my.id
SITE_URL=
SITE_TITLE=Hymn Router

# Rate limit endpoint /api/ai/chat per IP (default 20 req/menit).
AI_ROUTER_IP_RPM=20

# Rate limit per API key user (default 60 req/menit).
# Berlaku di /api/v1/* dan /api/ai/chat dengan header Bearer.
AI_ROUTER_KEY_RPM=60

# --- Login Google + dashboard + API key (lihat docs/setup.md) ---
# Tanpa 4 variabel ini, login/dashboard/API key tidak aktif — tapi
# landing page, playground anonim, dan /api/ai/chat tetap jalan normal.

# Google Cloud Console → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret untuk menandatangani session cookie. Wajib min 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Neon Postgres (neon.tech, gratis) — connection string.
# Jalankan `npm run migrate` setelah mengisi ini.
DATABASE_URL=

# Port untuk `npm run start` (Pterodactyl / VPS). Default Next 3000.
PORT=3000
